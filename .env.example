# Root-level reference for all environment variables.
# Actual .env files live in server/ and client/ respectively.

# ── Server (server/.env) ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pipelinehq
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ── Client (client/.env) ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api/v1
